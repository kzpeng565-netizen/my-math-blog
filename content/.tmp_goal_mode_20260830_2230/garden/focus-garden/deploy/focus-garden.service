[Unit]
Description=My Focus Garden private web application
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=conrad
Group=conrad
WorkingDirectory=/home/conrad/services/focus-garden
Environment=PYTHONUNBUFFERED=1
Environment=FOCUS_GARDEN_DRY_RUN=1
Environment=FOCUS_GARDEN_PI_LOCAL=1
ExecStart=/usr/bin/python3 /home/conrad/services/focus-garden/app.py --no-browser --port 8838
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
