[Unit]
Description=Evaluate the late-night device-use reminder policy
After=network-online.target syncthing@conrad.service phone-usage-receiver.service
Wants=network-online.target

[Service]
Type=oneshot
User=conrad
Group=conrad
WorkingDirectory=/home/conrad/workspace/activitywatch-advisor
EnvironmentFile=/home/conrad/.config/activitywatch-advisor/env
EnvironmentFile=-/home/conrad/.config/activitywatch-advisor/ntfy.env
ExecStart=/usr/bin/python3 /home/conrad/workspace/activitywatch-advisor/src/bedtime_reminder.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/conrad/workspace/activitywatch-advisor/data

[Install]
WantedBy=multi-user.target
