# 真实密钥只保存在树莓派 /home/conrad/.config/activitywatch-advisor/env
DEEPSEEK_API_KEY=replace-with-private-key

# PushPlus 用户令牌保存在独立的 pushplus.env；发送渠道在代码中固定为 wechat
PUSHPLUS_TOKEN=replace-with-private-token

# ntfy topic is private; keep the real value only in
# /home/conrad/.config/activitywatch-advisor/ntfy.env
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=replace-with-private-random-topic
NTFY_ENABLED=true
NTFY_TIMEOUT_SECONDS=10
NOTIFICATION_PROVIDER=ntfy
NOTIFICATION_FALLBACK_PROVIDER=pushplus
NOTIFICATION_FALLBACK_ENABLED=false
