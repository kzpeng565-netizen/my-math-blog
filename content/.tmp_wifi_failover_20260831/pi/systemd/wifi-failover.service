[Unit]
Description=Fail over Raspberry Pi Wi-Fi after sustained Internet loss
After=NetworkManager.service tailscaled.service
Wants=NetworkManager.service tailscaled.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/conrad/workspace/activitywatch-advisor/scripts/wifi_failover.py --config /home/conrad/workspace/activitywatch-advisor/config/wifi_failover.json
StateDirectory=wifi-failover
RuntimeDirectory=wifi-failover
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/wifi-failover /run/wifi-failover
