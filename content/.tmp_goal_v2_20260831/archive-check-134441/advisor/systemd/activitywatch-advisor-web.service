[Unit]
Description=Private web UI for reports and on-demand next-action suggestions
After=network-online.target syncthing@conrad.service phone-usage-receiver.service
Wants=network-online.target

[Service]
Type=simple
User=conrad
Group=conrad
WorkingDirectory=/home/conrad/workspace/activitywatch-advisor
EnvironmentFile=/home/conrad/.config/activitywatch-advisor/env
EnvironmentFile=-/home/conrad/.config/activitywatch-advisor/web.env
EnvironmentFile=-/home/conrad/.config/activitywatch-advisor/goal-agent.env
ExecStart=/usr/bin/python3 /home/conrad/workspace/activitywatch-advisor/src/web_app.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/conrad/workspace/activitywatch-advisor/data

[Install]
WantedBy=multi-user.target
